        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Endereco {\n  - logradouro: String\n  - numero: String\n  - cidade: String\n  - uf: String\n  + constructor(logradouro, numero, cidade, uf)\n  + get logradouro(): String\n  + get numero(): String\n  + get cidade(): String\n  + get uf(): String\n}\n\nclass Pessoa {\n  # nome: String\n  # endereco: Endereco\n  + constructor(nome: String, endereco: Endereco)\n  + get nome(): String\n  + set nome(valor: String)\n  + get endereco(): Endereco\n  + set endereco(valor: Endereco)\n}\n\nclass PessoaFisica {\n  # cpf: String\n  # dataNascimento: Date\n  + constructor(nome, endereco, cpf, dataNascimento)\n  + get cpf(): String\n  + set cpf(valor: String)\n  + get dataNascimento(): Date\n  + set dataNascimento(valor: Date)\n}\n\nclass PessoaJuridica {\n  # cnpj: String\n  # razaoSocial: String\n  + constructor(nome, endereco, cnpj, razaoSocial)\n  + get cnpj(): String\n  + set cnpj(valor: String)\n  + get razaoSocial(): String\n  + set razaoSocial(valor: String)\n}\n\nPessoa &lt;|-- PessoaFisica\nPessoa &lt;|-- PessoaJuridica\nPessoa *-- Endereco\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="01N8IlGc8lE4VkNuCO41-1">
